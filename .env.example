# URL pública del sitio (usada en metadata SEO, Open Graph, sitemap.xml).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Usadas por docker-compose.yml para el servicio mcp ---
# Clave requerida para autenticar al servidor MCP en modo HTTP.
# Genera una clave fuerte, p. ej.: openssl rand -hex 32
MCP_API_KEY=

# Orígenes permitidos para peticiones CORS al MCP, separados por coma.
MCP_ALLOWED_ORIGINS=http://localhost:3000
