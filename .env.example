# URL pública del sitio (usada en metadata SEO, Open Graph, sitemap.xml).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Usadas por docker-compose.yml para el servicio mcp ---
# Clave requerida para autenticar al servidor MCP en modo HTTP.
# Genera una clave fuerte, p. ej.: openssl rand -hex 32
MCP_API_KEY=

# Orígenes permitidos para peticiones CORS al MCP, separados por coma.
MCP_ALLOWED_ORIGINS=http://localhost:3000

# Secreto compartido entre `web` y `mcp` para revalidar la caché al
# instante tras publicar/editar una noticia (sin esto, el contenido nuevo
# tarda hasta 60s en aparecer en portada, vía el respaldo por tiempo).
# Genera una clave fuerte, p. ej.: openssl rand -hex 32
REVALIDATE_SECRET=

# --- Puertos en el host (127.0.0.1) ---
# Solo necesario cambiarlos si esos puertos ya están en uso en el
# servidor por otra aplicación (habitual en un servidor compartido con
# varias webs). Por defecto: 3000 (web) y 8787 (mcp).
# WEB_PORT=3050
# MCP_HOST_PORT=8790
