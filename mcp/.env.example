# Transporte del servidor MCP: "stdio" (por defecto, clientes locales) o "http".
MCP_TRANSPORT=stdio

# --- Solo necesario si MCP_TRANSPORT=http ---

# Puerto del servidor HTTP.
MCP_PORT=8787

# Clave requerida en el header `Authorization: Bearer <MCP_API_KEY>`.
# Genera una clave fuerte, p. ej.: openssl rand -hex 32
# NUNCA subas el valor real a git; este archivo es solo una plantilla.
MCP_API_KEY=

# Orígenes permitidos para peticiones CORS, separados por coma.
MCP_ALLOWED_ORIGINS=http://localhost:3000

# IPs/rangos CIDR de proxy de confianza para leer X-Forwarded-For al
# calcular el rate limit por IP (si no coincide, se usa la IP de la
# conexión TCP directa). Por defecto: loopback + 172.16.0.0/12 (cubre el
# caso típico de un Nginx del host llamando al contenedor, donde Docker
# reescribe el origen a una IP de su red interna). Sepáralas por coma.
# MCP_TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12

# --- Revalidación instantánea de la web tras publicar/editar ---

# URL interna donde responde el frontend (Next.js). Si corres `npm run
# dev`/`npm start` en esta misma máquina, el valor por defecto ya sirve.
# INTERNAL_WEB_URL=http://localhost:3000

# Mismo valor que REVALIDATE_SECRET en el .env del frontend. Si se deja
# vacío, el MCP sigue funcionando con normalidad, pero el contenido nuevo
# tarda hasta 60s en reflejarse en portada (respaldo por tiempo) en lugar
# de aparecer al instante.
REVALIDATE_SECRET=

# --- Opcional: anular ubicación del contenido (por defecto se autodetecta) ---
# CONTENT_ARTICLES_DIR=/ruta/absoluta/a/content/articles
# PUBLIC_IMAGES_DIR=/ruta/absoluta/a/public/images
# CONTENT_CATEGORIES_FILE=/ruta/absoluta/a/content/categories.json
